# Copy to app/.streamlit/secrets.toml (git-ignored) for local use, or paste
# into Streamlit Community Cloud -> App -> Settings -> Secrets.
# Leave the Supabase lines out to run on the local SQLite database instead.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
# Use the *secret* key (Project Settings -> API Keys -> Secret keys, starts
# with sb_secret_) or the legacy service_role key. Never the publishable/anon key.
SUPABASE_KEY = "sb_secret_..."

# Public address of the deployed app; used in share links and QR codes.
APP_URL = "https://your-app-name.streamlit.app"
